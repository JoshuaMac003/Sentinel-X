# SENTINEL-X Review 1 configuration
# Copy to .env and adjust as needed.

# Application
APP_NAME=SENTINEL-X
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api
LOG_LEVEL=INFO

# Database
# SQLite (default for local development):
DATABASE_URL=sqlite:///./data/sentinel_x.db
# PostgreSQL (production / docker-compose):
# DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:5432/sentinel_x

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Risk engine (baseline defaults — overridable)
RISK_WEIGHT_SEVERITY=0.35
RISK_WEIGHT_EXPLOITABILITY=0.25
RISK_WEIGHT_CRITICALITY=0.25
RISK_WEIGHT_PATH=0.15
